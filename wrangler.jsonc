{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dantegaleazzi",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-06-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
